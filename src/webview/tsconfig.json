{
	"compilerOptions": {
		"target": "ES2023",
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"skipLibCheck": true,
		"types": [],
		"paths": {
			"react": ["../../node_modules/@types/react"],
			"react/*": ["../../node_modules/@types/react/*"],
			"react-dom": ["../../node_modules/@types/react-dom"],
			"react-dom/*": ["../../node_modules/@types/react-dom/*"]
		}
	},
	"include": [
		"./**/*",
		"../shared/**/*"
	]
}
